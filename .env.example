# Copy to .env and fill in. Never commit .env.

# Default Medium username, without the @.
MEDIUM_USERNAME=

# Recommended when using a tunnel. Clients send it as X-MCP-Key.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=

# Your tunnel's hostname, without https:// (comma-separated for several).
MCP_ALLOWED_HOSTS=

MCP_HOST=127.0.0.1
MCP_PORT=8000
